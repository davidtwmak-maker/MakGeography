# Secrets — never commit real values
.env
.env.*
!.env.example

# Generated artefacts that may contain content derived from the teacher's vault
# (comment these in only if the repository is to stay code-only).
# data/kb.json
# data/mc_bank.json

# HKEAA's own briefing deck PDFs. They are published free for teachers, but
# they are HKEAA's files, not ours to redistribute. Fetch them locally with
# scripts/fetch_decks.py; only the rendered slide crops are committed.
data/papers/

# The raw OQB API records for the official HKEAA question bank. They carry
# Azure signed URLs and per-row access tokens, so they are never committed.
# Re-fetch them with the OQB downloader if the raw export is needed.
data/hkeaa_oqb/_raw/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS
.DS_Store
