# Secrets — never commit real values
.env
.env.*
!.env.example

# Generated artefacts that may contain content derived from the teacher's vault
# (comment these in only if the repository is to stay code-only).
# data/kb.json
# data/mc_bank.json

# HKEAA's own briefing deck PDFs. They are published free for teachers, but
# they are HKEAA's files, not ours to redistribute. Fetch them locally with
# scripts/fetch_decks.py; only the rendered slide crops are committed.
data/papers/

# The raw OQB API records for the official HKEAA question bank. They carry
# Azure signed URLs and per-row access tokens, so they are never committed.
# Re-fetch them with the OQB downloader if the raw export is needed.
data/hkeaa_oqb/_raw/

# The static site build output (scripts/build_static_site.py).
# GitHub Pages builds it in CI, so it is not committed.
site/

# The student roster and the activity log. The roster holds the names of
# the Form 6 students and a hash of each password; the log holds what
# each student asked. Neither belongs in a public repository, and the
# log grows with every question.
#
# The roster is built with scripts/build_roster.py and the passwords set
# with scripts/set_student_password.py. On the deployed site these are
# set as environment variables and a mounted file instead.
data/roster.json
data/activity_log.jsonl
data/activity_log.*.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS
.DS_Store
